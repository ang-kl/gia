# Gia4lunch — Phase 1 environment template
# Copy to .env and fill in real values. Never commit .env.

# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# From https://datamall.lta.gov.sg (DataMall v6.8)
# Optional in Phase 1: if unset, the LTA sniffer is skipped and /status
# returns a stub ("🟡 LTA sensor offline"). Wire this up to enable the
# real Pulse.
LTA_ACCOUNT_KEY=

# On Railway, set this to ${{Redis.REDIS_URL}} so it resolves to the
# internal private-network address. Locally, point at your dev Redis.
REDIS_URL=redis://localhost:6379

# From Google Cloud Console → Places API (New) → Credentials.
# Optional: if unset, /lunch falls back to a 5-spot seed list.
GOOGLE_MAPS_API_KEY=

# Webhook mode (kills Telegram 409 polling conflicts).
# On Railway, RAILWAY_PUBLIC_DOMAIN is auto-set when you enable
# Service → Settings → Networking → Generate Domain. Locally, leave
# WEBHOOK_DOMAIN unset to fall back to long-polling.
WEBHOOK_DOMAIN=

# Optional shared secret Telegram sends in X-Telegram-Bot-Api-Secret-Token.
# Auto-generated if unset, but pinning it survives restarts cleanly.
TELEGRAM_WEBHOOK_SECRET=
