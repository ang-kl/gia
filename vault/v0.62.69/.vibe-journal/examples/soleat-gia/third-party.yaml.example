# Example doc/third-party.yaml that a project drops in its own repo.
# The 3rd-Party tab in vibe-journal renders this alongside GitHub issues
# (if `gh` CLI is authenticated for the repo) and any other configured
# sources.
apis:
  - name: Places API (New) v1
    vendor: Google
    purpose: Venue lookup, searchText / searchNearby, Place Details, reviews, allowsDogs filter attribute.
    key_env_var: GOOGLE_MAPS_API_KEY
    docs_url: https://developers.google.com/maps/documentation/places/web-service/overview
    status: active
    daily_cap: 5000          # operator-configured in Cloud Console
    notes: petFriendly chip strict filter (v0.60.165) reads `places.allowsDogs`.

  - name: Geocoding API
    vendor: Google
    purpose: Reverse-geocode user coords, forward-geocode user-typed place names.
    key_env_var: GOOGLE_MAPS_API_KEY
    docs_url: https://developers.google.com/maps/documentation/geocoding/overview
    status: active
    daily_cap: 2000

  - name: Routes API (Distance Matrix)
    vendor: Google
    purpose: Walking minutes between user and venues.
    key_env_var: GOOGLE_MAPS_API_KEY
    docs_url: https://developers.google.com/maps/documentation/routes
    status: active

  - name: Claude (Sonnet 4.6, Haiku 4.5)
    vendor: Anthropic
    purpose: Tell-Gia NL → cuisine slugs; rankAndNarrate; /hidden grounding; web_search server-side tool.
    key_env_var: ANTHROPIC_API_KEY
    docs_url: https://docs.anthropic.com
    status: active

  - name: Gemini 2.5 Flash
    vendor: Google
    purpose: /hidden grounding + Michelin narrate (legacy path; Anthropic web_search primary since v0.40.0).
    key_env_var: GEMINI_API_KEY
    docs_url: https://ai.google.dev/gemini-api/docs
    status: dormant

  - name: LTA DataMall
    vendor: LTA Singapore
    purpose: MRT alerts, traffic, bus stops, carparks.
    key_env_var: LTA_ACCOUNT_KEY
    docs_url: https://datamall.lta.gov.sg/content/datamall/en.html
    status: active

  - name: NEA
    vendor: data.gov.sg
    purpose: Weather, 2-hour forecast.
    key_env_var: (none — public)
    docs_url: https://api-open.data.gov.sg
    status: active

  - name: HDB carpark availability
    vendor: data.gov.sg
    purpose: Carpark lot counts.
    docs_url: https://api.data.gov.sg
    status: active

integrations:
  - name: Telegram Bot + Mini App
    kind: messaging
    purpose: Primary user surface — bot commands + 5 TMAs (Cuisine, Menu, Hawker, Transport, Oversight).
    docs_url: https://core.telegram.org/bots/api
    status: active

  - name: Redis (Railway managed)
    kind: data store
    purpose: chatId-hashed location cache, recent-picks, free-text log, usage-counters, cuisine-session state.
    docs_url: https://redis.io/docs
    status: active

  - name: Railway
    kind: hosting
    purpose: Webhook + Express server + Redis + GitHub Actions trigger.
    docs_url: https://docs.railway.com
    status: active
